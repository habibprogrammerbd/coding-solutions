#include <bits/stdc++.h>
using namespace std;

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++)
        {
            cin >> v[i];
        }
        
        int s = 0, e = n - 1;
        while (s < e && v[s] == v[e])
            s++, e--;

        if (s >= e)
        {
            cout << "NO\n";
            continue;
        }

        for (int y = 1; y <= 3; y++)
        {
            if (y != v[s] && y != v[e])
            {
                cout << "YES " << y << "\n";
                break;
            }
        }
    }
    return 0;
}