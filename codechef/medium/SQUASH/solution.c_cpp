// ---------------- PBDS ----------------
template <typename T>
using pbds = tree<T, null_type, less<T>, rb_tree_tag, tree_order_statistics_node_update>;

// -----------------YES and NO-------------
inline void YES() { cout << "YES\n"; }
inline void NO() { cout << "NO\n"; }

// ---------------- Solve ----------------
void solve()
{
    int n, k;
    cin >> n >> k;

    string s;
    cin >> s;

    int i = 0;
    bool x = false;
    while (s.size() > k && i < (int)s.size() - 1)
    {
        char c = s[i];

        if (c == s[i + 1])
        {
            s.erase(i, 1);
            if (i > 0)
                i--;
        }
        else
            i++;

        // if (k == s.size())
        // {
        //     x = true;
        //     break;
        // }
    }

    if (k == s.size())
        cout << "YES\n";
    else
        cout << "NO\n";
}

signed main()
{
    fast_io

        int t;
    cin >> t;
    while (t--)
    {
        solve();
    }

    return 0;
}